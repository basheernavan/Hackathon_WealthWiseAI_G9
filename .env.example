# Copy to .env (never commit .env). Without a key the app still runs, using template text.
OPENROUTER_API_KEY=
# Any OpenRouter model id with structured-output support. Backup: deepseek/deepseek-v3.2
WEALTHWISE_MODEL=anthropic/claude-haiku-5.5
# Optional LangSmith tracing and evals (local only; do not add these to Streamlit Cloud Secrets).
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=wealthwise
